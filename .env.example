# FINLENS Environment Variables
# Copy this file to .env and configure your variables

# Optional: Google Gemini API Key for deep AI brief generation.
# If not provided, FINLENS automatically uses its built-in deterministic financial intelligence engine.
AI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Default: 3001)
PORT=3001

# Vite Client Port (Default: 5173)
VITE_PORT=5173
